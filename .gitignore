# Python / local runtime
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments and local tools
adv_robust/
.venv/
venv/
env/

# Git repair / backup directories
.git.broken*/
.git.fetch_failed*/

# Logs and monitor outputs
logs/
*.log
*.out
*.err

# Large experiment outputs belong in R2, not GitHub.
results/
gradient_audit/
path_audit/
fno_training_runs/

# Large datasets and checkpoints belong in R2.
1D_Burgers/datasets/
1D_Burgers/trained_models/
deeponet_training_runs/
checkpoints/
datasets/

# Binary scientific artifacts belong in R2 unless explicitly force-added.
*.pt
*.pth
*.ckpt
*.npz
*.npy
*.pkl
*.pickle
*.h5
*.hdf5
*.nc
*.mat

# Generated media usually belongs in R2.
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.mov
*.avi
*.pdf

# Keep code, docs, configs, and small manifests trackable.
!docs/
!docs/**/*.md
!tools/
!tools/**/*.py
!tools/**/*.sh
!*.py
!*.sh
!*.md
!requirements.txt
!README.md
