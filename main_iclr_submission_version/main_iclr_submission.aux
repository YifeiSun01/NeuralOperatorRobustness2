\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Top-$k$ right-singular subspace similarity. Entries are the mean principal cosine $s_k$; higher value indicates stronger local alignment. For FNO, the model and solver subspaces are highly aligned, while the error subspace is separated; this is especially clear at $\nu =10^{-2}$. DeepONet behaves differently: its model and error subspaces are close to each other and both are far from the solver subspace.}}{41}{table.17}\protected@file@percent }
\newlabel{tab:local-svd-subspace-similarity}{{17}{41}{Top-$k$ right-singular subspace similarity. Entries are the mean principal cosine $s_k$; higher value indicates stronger local alignment. For FNO, the model and solver subspaces are highly aligned, while the error subspace is separated; this is especially clear at $\nu =10^{-2}$. DeepONet behaves differently: its model and error subspaces are close to each other and both are far from the solver subspace}{table.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Rank-matched right singular vector angles, in degrees. Unlike the top-$k$ subspace similarity in Table~\ref {tab:local-svd-subspace-similarity}, this table forces the $r$th right singular vector of one Jacobian to match the $r$th right singular vector of the other Jacobian. The FNO rows show small model--solver angles but large model--error angles, so model- or solver-driven directions mostly move both outputs together; discrepancy growth needs the error directions.}}{42}{table.18}\protected@file@percent }
\newlabel{tab:local-svd-rank-angles}{{18}{42}{Rank-matched right singular vector angles, in degrees. Unlike the top-$k$ subspace similarity in \tabref {tab:local-svd-subspace-similarity}, this table forces the $r$th right singular vector of one Jacobian to match the $r$th right singular vector of the other Jacobian. The FNO rows show small model--solver angles but large model--error angles, so model- or solver-driven directions mostly move both outputs together; discrepancy growth needs the error directions}{table.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces FNO leading singular values. Values are averaged over the five local inputs used in the SVD diagnostic.}}{42}{table.19}\protected@file@percent }
\newlabel{tab:local-svd-singular-values}{{19}{42}{FNO leading singular values. Values are averaged over the five local inputs used in the SVD diagnostic}{table.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces FNO Fourier-energy quantiles of individual leading right singular vectors. Each row reports one right singular vector $v_r$; values are averaged over the five local inputs, but not averaged across ranks. The quantity $q_p(v_r)$ is reported as a Fourier mode index: for length-$1024$ vectors, the non-DC one-sided rFFT modes are $1,\ldots  ,512$. For each local input, $q_p$ is the first mode where the cumulative non-DC raw rFFT energy reaches $p\%$; the table reports the mean of these five integer modes, hence non-integer entries. Larger values indicate higher-frequency directions.}}{43}{table.20}\protected@file@percent }
\newlabel{tab:local-svd-frequency}{{20}{43}{FNO Fourier-energy quantiles of individual leading right singular vectors. Each row reports one right singular vector $v_r$; values are averaged over the five local inputs, but not averaged across ranks. The quantity $q_p(v_r)$ is reported as a Fourier mode index: for length-$1024$ vectors, the non-DC one-sided rFFT modes are $1,\ldots ,512$. For each local input, $q_p$ is the first mode where the cumulative non-DC raw rFFT energy reaches $p\%$; the table reports the mean of these five integer modes, hence non-integer entries. Larger values indicate higher-frequency directions}{table.20}{}}
