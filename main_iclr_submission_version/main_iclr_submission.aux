\@writefile{toc}{\contentsline {paragraph}{Finite attack loss increase.}{37}{section*.44}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Jacobian-error norm.}{37}{section*.45}\protected@file@percent }
